@page "~/Libraries/{libraryId:guid}/Videos/{videoId:guid}/{handler?}"
@using System.Globalization
@using NodaTime
@using NodaTime.Text
@using Tubeshade.Server.Pages.Shared
@using Tubeshade.Server.Services
@model Video
@{
    ViewData["Title"] = Model.Entity.Name;
}

@section Navigation
{
    @await Html.PartialAsync("_LibraryNavigation", Model.Library)
}

<div class="row">
    <div class="col-md-12 col-lg">
        <video id="video" controls="@(Model.PlayableFiles is not [])" playsinline preload="metadata" width="100%"
               poster="@Model.PosterUrl"
               disabled="@(Model.PlayableFiles is [])">

            @foreach (var file in Model.PlayableFiles.OrderBy(file => file.Id != Model.PreferredFile?.Id))
            {
                <source
                    src="@Url.Action("GetFile", "Videos", new { version = "1.0", id = Model.VideoId, fileId = file.Id })"
                    type="video/@file.Type.Name"/>
            }

            @foreach (var track in Model.Subtitles)
            {
                <track
                    src="@Url.Action("GetSubtitles", "Videos", new { version = "1.0", id = Model.VideoId, language = track.Language })"
                    label="@track.Language" kind="subtitles" srclang="@track.Language"
                    default="@(Model.Subtitles.Count is 1)"/>
            }

            @if (Model.Chapters is not null)
            {
                <track
                    src="@Url.Action("GetChapters", "Videos", new { version = "1.0", id = Model.VideoId })"
                    kind="chapters" srclang="en" default/>
            }

            @if (Model.PlayableFiles is not [])
            {
                <track
                    src="@Url.Action("GetSponsorBlockSegments", "Videos", new { version = "1.0", id = Model.VideoId })"
                    kind="metadata" srclang="en" label="SponsorBlock" default/>
            }
        </video>
    </div>

    <section id="video-controls" class="col-md-12 col-lg-4 col-xxl-3">
        <div class="row" hidden="@(Model.PlayableFiles is [])">
            <div class="col-6 col-lg-12 mb-3">
                <div class="row">
                    <label for="sources" class="col-4 col-md-3 col-form-label">@SharedResources.Video_Resolution</label>
                    <div class="col">
                        <select id="sources" class="form-control form-select"
                                disabled="@(Model.PlayableFiles.Count < 2)">
                            @foreach (var file in Model.PlayableFiles)
                            {
                                <option
                                    value="@Url.Action("GetFile", "Videos", new { version = "1.0", id = Model.VideoId, fileId = file.Id })">
                                    @(file.Height)@@@(file.Framerate)
                                </option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-12 mb-3">
                <div class="row">
                    <label for="playback-rate-input"
                           class="col-4 col-md-3 col-form-label">@SharedResources.Video_Speed</label>
                    <div class="col">
                        <input id="playback-rate-input" class="form-control" type="number" min="0.25" max="16" step="0.25"
                               value="@Model.PlaybackSpeed"/>
                    </div>
                </div>
            </div>
        </div>

        <div id="chapter-marker-div" hidden class="mb-3 mb-lg-0">
            <label for="chapter-markers" class="form-label" hidden="hidden">@SharedResources.Video_Chapter</label>
            <select id="chapter-markers" class="form-control form-select overflow-auto"></select>
        </div>
    </section>
</div>

<h3>@Model.Entity.Name</h3>

<div class="row mb-2">
    <div class="col-auto">
        <a asp-page="/Libraries/Channels/Channel" asp-route-libraryId="@Model.LibraryId"
           asp-route-channelId="@Model.Channel.Id">
            @Model.Channel.Name
        </a>
    </div>
    <div class="col-auto">
        <a href="@Model.Entity.ExternalUrl">@SharedResources.Original</a>
        (@(SharedResources.ResourceManager.GetString($"Video_ExternalAvailability_{Model.Entity.Availability.Name}")))
    </div>
    <form class="col-auto">
        <input value="@(Model.VideoId)" name="videoId" hidden/>
        <div class="form-check form-check-inline form-switch">
            <input id="viewed" checked="@(Model.Entity.Viewed is true)" name="viewed"
                   type="checkbox" role="switch" switch title="Viewed" class="form-check-input"
                   hx-post="" hx-page-handler="Viewed" hx-swap="none"
                   hx-on::after-request="if (!event.detail.successful) this.checked = !event.detail.requestConfig.formData.has('viewed')"/>
            <label for="viewed" class="form-check-label">
                @SharedResources.Filters_ViewStatus_viewed
            </label>
        </div>
    </form>
    <div class="col-auto">
        @SharedResources.Filters_SortVideoBy_published_at
        <time datetime="@InstantPattern.General.Format(Model.Entity.PublishedAt)">
            @LocalDatePattern.Iso.Format(Model.Entity.PublishedAt.InUtc().Date)
        </time>
    </div>
    <div class="col-auto">
        @SharedResources.Filters_SortVideoBy_refreshed_at
        <time datetime="@InstantPattern.General.Format(Model.Entity.RefreshedAt)">
            @LocalDatePattern.Iso.Format(Model.Entity.RefreshedAt.InUtc().Date)
        </time>
    </div>
    @if (Model.Entity.ViewCount is { } viewCount)
    {
        <div class="col-auto">
            @(string.Format(SharedResources.Video_Views, viewCount.FormatCount(CultureInfo.CurrentCulture)))
        </div>
    }
    @if (Model.Entity.LikeCount is { } likeCount)
    {
        <div class="col-auto">
            @(string.Format(SharedResources.Video_Likes, likeCount.FormatCount(CultureInfo.CurrentCulture)))
        </div>
    }
    @if (Model.PlaybackStatistics is { PlayCount: > 0 } statistics)
    {
        <div class="col-auto">
            @(string.Format(SharedResources.Video_Plays, statistics.PlayCount.ToString(CultureInfo.CurrentCulture)))
        </div>
    }
    @if (Model.PlaybackStatistics.WatchTime >= 1)
    {
        <div class="col-auto">
            @(string.Format(SharedResources.Video_WatchTime, RoundedHumanReadablePeriodPattern.TwoPlaces.Format(Period.FromSeconds((long)Math.Truncate(Model.PlaybackStatistics.WatchTime)))))
        </div>
    }
</div>

@if (Model.Entity.Categories.Length > 0 || Model.Entity.Tags.Length > 0)
{
    <div class="row mb-2">
        <div class="d-flex flex-row flex-wrap">
            @foreach (var category in Model.Entity.Categories)
            {
                <span class="badge rounded-pill bg-primary m-1">@category</span>
            }

            @foreach (var tag in Model.Entity.Tags)
            {
                <span class="badge rounded-pill bg-secondary m-1">@tag</span>
            }
        </div>
    </div>
}

<div class="row mb-2">
    <div class="col-auto">
        <button hx-post="" hx-page-handler="Scan" class="btn btn-primary btn-sm">
            @SharedResources.Button_Rescan
        </button>
    </div>

    @if (Model.DownloadableFiles is not [])
    {
        <div class="col-auto">
            <button hx-post="" hx-page-handler="Download" class="btn btn-primary btn-sm">
                @SharedResources.Button_Download
            </button>
        </div>
    }

    <div class="col-auto">
        <a asp-page="/Libraries/Videos/Edit" asp-route-libraryId="@Model.LibraryId" asp-route-videoId="@Model.VideoId"
           class="btn btn-primary btn-sm">
            @SharedResources.Button_Edit
        </a>
    </div>

    <div class="col-auto">
        <button hx-post="" hx-page-handler="Delete" hx-confirm="Are you sure you want to delete this video?"
                class="btn btn-danger btn-sm">
            @SharedResources.Button_Delete
        </button>
    </div>
</div>

<details open="open">
    <summary>@SharedResources.Video_Description</summary>
    @Model.DescriptionContent
</details>

@section Scripts
{
    <script type="module">
        import {setPreferredResolution} from "/js/modules/device-preferences.js";

        const video = document.querySelector("#video");
        video.playbackRate = @Model.PlaybackSpeed.ToString(CultureInfo.InvariantCulture);
        @if (Model.Time is { } time)
        {
            @: video.currentTime = @(time.ToString(CultureInfo.InvariantCulture));
        }
        else if (Model.Entity.Position is { } position and > Defaults.PlaybackEpsilon)
        {
            @: video.currentTime = @(position.ToString(CultureInfo.InvariantCulture));
        }

        const reportingPeriod = @Defaults.ReportPeriodInSeconds.ToString(CultureInfo.InvariantCulture);
        const minimumPlayFraction = @Defaults.MinimumPlayFraction.ToString(CultureInfo.InvariantCulture);
        const playbackEpsilon = @Defaults.PlaybackEpsilon.ToString(CultureInfo.InvariantCulture);
        const restartPlayFraction = @Defaults.RestartPlayFraction.ToString(CultureInfo.InvariantCulture);

        // real time spent playing the video since the last report, regardless of playback rate
        let unreportedWatchTime = 0;
        let unreportedPlaybackTime = 0;
        // video time played since the current play started, used to decide whether the video counts as played
        let playedVideoTime = 0;

        let playCounted = false;
        let trackingInterval = null;
        let lastTrackedAt = 0;
        let lastTrackedTime = 0;
        let lastPlaybackRate = 1;

        video.addEventListener("playing", startTracking, false);
        video.addEventListener("seeked", startTracking, false);
        video.addEventListener("pause", stopTracking, false);
        video.addEventListener("waiting", stopTracking, false);
        video.addEventListener("seeking", stopTracking, false);
        video.addEventListener("emptied", stopTracking, false);
        video.addEventListener("ratechange", () => {
            if (trackingInterval !== null) {
                trackPlayback();
            }
        }, false);

        // "pause" is fired before "ended", so the previous play is already tracked
        video.addEventListener("ended", startNewPlay, false);
        video.addEventListener("seeking", () => {
            if (playCounted && video.currentTime < Math.min(playbackEpsilon, video.duration * restartPlayFraction)) {
                startNewPlay();
            }
        }, false);

        video.addEventListener("pause", reportPlaybackActivity, false);
        video.addEventListener("play", reportPlaybackActivity, false);
        video.addEventListener("seeked", reportPlaybackActivity, false);

        document.addEventListener("pagehide", reportPlaybackActivity, false);
        document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "hidden") {
                reportPlaybackActivity();
            }
        });

        function startTracking() {
            // "seeked" is also fired while paused, and "playing" will follow if the video is still buffering
            if (trackingInterval !== null || video.paused || video.readyState < HTMLMediaElement.HAVE_FUTURE_DATA) {
                return;
            }

            lastTrackedAt = performance.now();
            lastTrackedTime = video.currentTime;
            lastPlaybackRate = video.playbackRate;
            trackingInterval = setInterval(onTrackingInterval, 1000);
        }

        function startNewPlay() {
            playedVideoTime = 0;
            playCounted = false;
        }

        function stopTracking() {
            if (trackingInterval === null) {
                return;
            }

            clearInterval(trackingInterval);
            trackingInterval = null;
            trackPlayback();
        }

        function onTrackingInterval() {
            trackPlayback();
            if (unreportedWatchTime >= reportingPeriod) {
                reportPlaybackActivity();
            }
        }

        function trackPlayback() {
            // background tabs throttle timers, so measure the elapsed time instead of counting intervals
            const now = performance.now();
            const currentTime = video.currentTime;
            const elapsed = (now - lastTrackedAt) / 1000;
            const advanced = currentTime - lastTrackedTime;
            const playbackRate = lastPlaybackRate;

            lastTrackedAt = now;
            lastTrackedTime = currentTime;
            lastPlaybackRate = video.playbackRate;

            // the wall clock keeps going if playback stalls without "waiting" or the device sleeps,
            // and currentTime already points to the seek target when "seeking" stops tracking
            const played = Math.max(0, Math.min(advanced, elapsed * playbackRate));
            if (played === 0) {
                return;
            }

            unreportedWatchTime += played / playbackRate;
            unreportedPlaybackTime += played;
            playedVideoTime += played;

            if (!playCounted && playedVideoTime >= getPlayableDuration() * minimumPlayFraction) {
                playCounted = navigator.sendBeacon("@(Url.Action("AddPlay", "Videos", new { version = "1.0", id = Model.VideoId }))");
            }
        }

        function getPlayableDuration() {
            const cues = sponsorBlockTrack?.track.cues ?? [];
            let skippedDuration = 0;
            let skippedUntil = 0;

            for (let i = 0; i < cues.length; i++) {
                const cue = cues[i];
                const [category, action] = cue.text.split(" ");
                if (category === "filler" || action === "mute") {
                    continue;
                }

                const start = Math.max(cue.startTime, skippedUntil);
                if (cue.endTime > start) {
                    skippedDuration += cue.endTime - start;
                    skippedUntil = cue.endTime;
                }
            }

            // segments can cover the whole video
            const playableDuration = video.duration - skippedDuration;
            return playableDuration > 0 ? playableDuration : video.duration;
        }

        function reportPlaybackActivity() {
            if (trackingInterval !== null) {
                trackPlayback();
            }

            const currentTime = video.currentTime;
            const position = Math.abs(video.duration - currentTime) < 0.1
                ? 0
                : currentTime;

            const queued = navigator.sendBeacon(
                "@(Url.Action("SavePlaybackActivity", "Videos", new { version = "1.0", id = Model.VideoId }))",
                new Blob(
                    [JSON.stringify({position: position, watchTimeDelta: unreportedWatchTime, playbackTimeDelta: unreportedPlaybackTime})],
                    {type: "application/json"}));

            // if the browser refuses the beacon, the time is sent with the next report
            if (queued) {
                unreportedWatchTime = 0;
                unreportedPlaybackTime = 0;
            }
        }

        if ("mediaSession" in navigator) {
            const posterUrl = @Html.Raw(Model.PosterUrl?.ToJson() ?? "null");
            if (posterUrl !== null) {
                // since thumbnail endpoint requires authentication, the artwork source cannot be simply set to the url of the thumbnail
                // we need to fetch it within the page context, and encode it into a data url
                fetch(posterUrl)
                    .then(response => response.blob())
                    .then(blob => {
                        const blobUrl = URL.createObjectURL(blob);
                        navigator.mediaSession.metadata = new MediaMetadata({
                            title: @Html.Raw(Model.Entity.Name.ToJson()),
                            album: @Html.Raw(Model.Library.Name.ToJson()),
                            artist: @Html.Raw(Model.Channel.Name.ToJson()),
                            artwork: [
                                {
                                    src: blobUrl,
                                    type: "@(System.IO.Path.GetExtension(Model.Poster?.StoragePath)?.GetImageMediaType())",
                                    sizes: "@($"{Model.Poster?.Width}x{Model.Poster?.Height}")"
                                }
                            ],
                        });
                    });
            }

            navigator.mediaSession.setActionHandler("play", () => video.play());
            navigator.mediaSession.setActionHandler("pause", () => video.pause());
            navigator.mediaSession.setActionHandler("stop", () => video.pause());
            navigator.mediaSession.setActionHandler("seekforward", (event) => {
                const skipTime = event.seekOffset || 10;
                video.currentTime = Math.min(video.currentTime + skipTime, video.duration);
            });
            navigator.mediaSession.setActionHandler("seekbackward", (event) => {
                const skipTime = event.seekOffset || 10;
                video.currentTime = Math.max(video.currentTime - skipTime, 0);
            });
            navigator.mediaSession.setActionHandler("seekto", (event) => {
                video.currentTime = event.seekTime;
            });
        }

        const sourcesSelector = document.querySelector("#sources");

        // set the selected option to the source currently selected by the browser
        for (let index = 0; index < sourcesSelector.options.length; index++) {
            if (video.currentSrc.endsWith(sourcesSelector.options[index].value)) {
                sourcesSelector.selectedIndex = index;
            }
        }

        sourcesSelector.addEventListener("change", onSourcesSelectorChanged, false);
        setPreferredResolution(sourcesSelector, "@Model.FileId");

        function onSourcesSelectorChanged() {
            const source = sourcesSelector.options[sourcesSelector.selectedIndex].value;
            if (video.currentSrc.endsWith(source)) {
                return;
            }

            const currentTime = video.currentTime;
            const currentPlaybackRate = video.playbackRate;
            const paused = video.paused;

            video.src = source;
            video.currentTime = currentTime;
            video.playbackRate = currentPlaybackRate;
            if (!paused) {
                video.play();
            }
        }

        const playbackRateInput = document.querySelector("#playback-rate-input");
        playbackRateInput.addEventListener("change", onPlaybackSpeedInputChange, false);

        function onPlaybackSpeedInputChange() {
            const playbackRate = playbackRateInput.valueAsNumber;
            // browsers only support a limited range of playback rates, and a rate of 0 stops playback
            if (isNaN(playbackRate) || playbackRateInput.validity.rangeUnderflow || playbackRateInput.validity.rangeOverflow) {
                playbackRateInput.value = video.playbackRate;
                return;
            }

            if (video.playbackRate !== playbackRate) {
                video.playbackRate = playbackRate;
            }
        }

        video.addEventListener("ratechange", onVideoRateChange, false);

        function onVideoRateChange() {
            if (playbackRateInput.valueAsNumber !== video.playbackRate) {
                playbackRateInput.value = video.playbackRate;
            }
        }

        video.addEventListener("ended", onVideoEnded, false);

        function onVideoEnded() {
            const viewedInput = document.querySelector("#viewed");
            // the playback position is reset by the "pause" event, which is fired before "ended"
            if (viewedInput.checked === true) {
                return;
            }

            viewedInput.checked = true;
            viewedInput.dispatchEvent(new Event("change"));
        }

        const chaptersTrack = video.querySelector('track[kind="chapters"]');
        if (chaptersTrack !== null) {
            const chapters = document.querySelector("#chapter-markers");
            const chaptersSection = document.querySelector("#chapter-marker-div");
            let tracksLoaded = false;

            if (chaptersTrack.readyState === 2) {
                console.debug("Chapters track already loaded");
                onChaptersTrackLoad();
            } else {
                console.debug("Waiting for chapters track to load");
                chaptersTrack.addEventListener("load", onChaptersTrackLoad, false);
                chaptersTrack.addEventListener("loaded", onChaptersTrackLoad, false);
            }

            function onChaptersTrackLoad() {
                if (tracksLoaded) {
                    return;
                }

                tracksLoaded = true;

                if ("mediaSession" in navigator) {
                    navigator.mediaSession.setActionHandler("nexttrack", (_event) => {
                        const cues = chaptersTrack.track.cues;
                        const currentTime = video.currentTime;

                        let currentCue = null;
                        let nextCue = null;

                        for (let index = 0; index < cues.length; index++) {
                            const cue = cues[index];

                            if (cue.endTime <= currentTime) {
                                continue;
                            } else if (cue.startTime <= currentTime && currentTime < cue.endTime) {
                                currentCue = cue;
                            } else {
                                nextCue = cue;
                                break;
                            }
                        }

                        if (nextCue !== null) {
                            video.currentTime = nextCue.startTime;
                        } else if (currentCue !== null) {
                            video.currentTime = currentCue.endTime;
                        } else {
                            video.currentTime = video.duration;
                        }
                    });

                    navigator.mediaSession.setActionHandler("previoustrack", (_event) => {
                        const cues = chaptersTrack.track.cues;
                        const currentTime = video.currentTime;

                        let previousCue = null;
                        let currentCue = null;

                        for (let index = 0; index < cues.length; index++) {
                            const cue = cues[index];

                            if (cue.endTime <= currentTime) {
                                previousCue = cue;
                            } else if (cue.startTime <= currentTime && currentTime < cue.endTime) {
                                currentCue = cue;
                            } else {
                                break;
                            }
                        }

                        if (previousCue !== null) {
                            video.currentTime = previousCue.startTime;
                            if (video.paused) {
                                video.play();
                            }
                        } else if (currentCue !== null) {
                            video.currentTime = currentCue.startTime;
                        } else {
                            video.currentTime = 0;
                        }
                    });
                }

                chaptersSection.removeAttribute("hidden");

                for (const cue of chaptersTrack.track.cues) {
                    createMarker(cue);
                }

                chaptersTrack.addEventListener("cuechange", onChapterCueChange);
                chapters.size = Math.min(9, chaptersTrack.track.cues.length);
                chapters.addEventListener("change", onChaptersChange);
            }

            function createMarker(cue) {
                let timestamp = new Date(cue.startTime * 1000).toISOString().slice(11, 19);
                if (timestamp.startsWith("00:")) {
                    timestamp = timestamp.slice(3);
                }

                const option = document.createElement("option");
                option.value = cue.startTime;
                option.innerHTML = `${timestamp} - ${cue.text}`;
                chapters.appendChild(option);
            }

            function onChapterCueChange(_event) {
                const activeCues = chaptersTrack.track.activeCues;
                if (activeCues.length === 0) {
                    console.warn("Chapters cue changed, but none are active");
                    return;
                }

                const cue = activeCues[activeCues.length - 1];
                chapters.value = cue.startTime;
                reportPlaybackActivity();
            }

            function onChaptersChange(event) {
                video.currentTime = event.target.value;
            }
        }

        const sponsorBlockTrack = video.querySelector('track[kind="metadata"][label="SponsorBlock"]');
        if (sponsorBlockTrack !== null) {
            if (sponsorBlockTrack.readyState === 2) {
                console.debug("SponsorBlock track already loaded");
                onSponsorBlockTrackLoad();
            } else {
                console.debug("Waiting for SponsorBlock track to load");
                sponsorBlockTrack.addEventListener("load", onSponsorBlockTrackLoad, false);
                sponsorBlockTrack.addEventListener("loaded", onSponsorBlockTrackLoad, false);
            }
        }

        function onSponsorBlockTrackLoad() {
            sponsorBlockTrack.addEventListener("cuechange", onSponsorBlockCueChange);
        }

        // only unmute the video if it was muted because of a segment
        let mutedBySegment = false;

        function onSponsorBlockCueChange(_event) {
            const activeCues = sponsorBlockTrack.track.activeCues;
            let skippableCues = [];
            let mute = false;

            for (let i = 0; i < activeCues.length; i++) {
                const cue = activeCues[i];
                // cached tracks might contain only the category, those segments are skipped
                const [category, action] = cue.text.split(" ");
                if (category === "filler") {
                    continue;
                }

                if (action === "mute") {
                    mute = true;
                } else {
                    skippableCues.push(cue);
                }
            }

            if (mute && !video.muted) {
                video.muted = true;
                mutedBySegment = true;
            } else if (!mute && mutedBySegment) {
                video.muted = false;
                mutedBySegment = false;
            }

            if (skippableCues.length === 0) {
                return;
            }

            video.currentTime = skippableCues
                .map(cue => cue.endTime)
                .reduce((previous, current) => (previous > current) ? previous : current);
        }
    </script>
}
