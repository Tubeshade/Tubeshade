<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\SponsorBlock\SponsorBlock.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Ardalis.SmartEnum"/>
        <PackageReference Include="Dapper"/>
        <PackageReference Include="dbup-core"/>
        <PackageReference Include="dbup-postgresql"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Identity.Core"/>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
        <PackageReference Include="NodaTime"/>
        <PackageReference Include="Npgsql"/>
        <PackageReference Include="Npgsql.NodaTime"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Migrations\*.sql"/>
    </ItemGroup>

    <!-- Media/Videos/VideoRepository.Find.sql becomes VideoRepository.Queries.Find at compile time. -->
    <ItemGroup>
        <ProjectReference Include="..\Tubeshade.Data.Generators\Tubeshade.Data.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <AdditionalFiles Include="**\*.sql" Exclude="Migrations\**;$(BaseOutputPath)**;$(BaseIntermediateOutputPath)**">
            <DependentUpon>$([System.Text.RegularExpressions.Regex]::Replace('%(Filename)', '\..*$', '')).cs</DependentUpon>
        </AdditionalFiles>
        <CompilerVisibleProperty Include="RootNamespace"/>
        <CompilerVisibleProperty Include="MSBuildProjectDirectory"/>
        <InternalsVisibleTo Include="Tubeshade.Server.Tests.Integration"/>
    </ItemGroup>

</Project>
